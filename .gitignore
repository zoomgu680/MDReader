# ============================================================
# MDReader - .gitignore
# ============================================================

# ---- Rust / Tauri 构建产物 ----
src-tauri/target/
**/*.rs.bk

# ---- 日志文件 ----
*.log
build*.log
build_offline*.log
build_online*.log
build_img*.log

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*.sln
*.suo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- 临时 / 备份文件 ----
*.tmp
*.bak
*.orig
*~

# ---- Node（如后续引入前端构建工具）----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 环境变量 / 密钥 ----
.env
.env.local
*.pem
*.key
