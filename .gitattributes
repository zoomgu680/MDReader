# 统一行尾策略：仓库内一律 LF，Windows 工作区自动转 CRLF
# 此文件让跨平台协作时不再出现 LF/CRLF 警告

*          text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Unix 脚本保持 LF
*.sh       text eol=lf

# 二进制文件，不做行尾转换
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.min.js   binary
*.min.css  binary
